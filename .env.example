# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional. Google Maps Platform API key with Places API enabled for live Google Maps ratings, reviews & place details.
GOOGLE_MAPS_API_KEY=

# BPS_WEB_API_KEY: Optional. Web API Key from Badan Pusat Statistik (https://webapi.bps.go.id/) for fetching live BPS data directly from webapi.bps.go.id.
BPS_WEB_API_KEY=

# TWITTER_BEARER_TOKEN: Optional. Twitter/X API v2 Bearer Token for live tweet streaming & search
TWITTER_BEARER_TOKEN=

# YOUTUBE_API_KEY: Optional. Google Cloud YouTube Data API v3 key for live tourism vlog & video querying
YOUTUBE_API_KEY=

# META_GRAPH_ACCESS_TOKEN: Optional. Meta Graph API Access Token for Instagram Hashtag & Media queries
META_GRAPH_ACCESS_TOKEN=

# INSTAGRAM_ACCOUNT_ID: Optional. Instagram Professional/Business Account ID for Meta Graph API
INSTAGRAM_ACCOUNT_ID=

# TIKTOK_ACCESS_TOKEN: Optional. TikTok Research or Commercial Content API Access Token
TIKTOK_ACCESS_TOKEN=
